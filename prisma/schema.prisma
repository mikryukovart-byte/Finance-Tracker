generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         String
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([id, userId])
  @@unique([userId, name, type])
  @@index([userId, type])
}

model Account {
  id                String        @id @default(cuid())
  userId            String
  name              String
  type              String        @default("DEBIT")
  balance           Float         @default(0)
  currency          String        @default("RUB")
  creditLimit       Float?
  currentDebt       Float         @default(0)
  availableCredit   Float         @default(0)
  minimalPayment    Float?
  paymentDate       DateTime?
  interestRate      Float?
  transactions      Transaction[]
  linkedLoans       Loan[]
  outgoingTransfers Transfer[]    @relation("TransferFromAccount")
  incomingTransfers Transfer[]    @relation("TransferToAccount")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([id, userId])
  @@unique([userId, name])
  @@index([userId, type])
  @@index([userId, currency])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String
  date        DateTime
  description String?
  categoryId  String?
  accountId   String?
  category    Category? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  account     Account? @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  loanPayments LoanPayment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, accountId])
  @@index([categoryId])
}

model Loan {
  id              String   @id @default(cuid())
  userId          String
  debtType        String   @default("BANK_LOAN")
  title           String
  lender          String?
  initialAmount   Float?
  remainingAmount Float
  monthlyPayment  Float?
  plannedPayment  Float?
  minimalPayment  Float?
  creditLimit     Float?
  interestRate    Float?
  gracePeriodDays Int?
  paymentDate     DateTime?
  accountId       String?
  account         Account? @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  priority        String   @default("MEDIUM")
  status          String   @default("ACTIVE")
  payments        LoanPayment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, debtType])
  @@index([userId, priority])
  @@index([userId, paymentDate])
  @@index([userId, accountId])
}

model Transfer {
  id            String   @id @default(cuid())
  userId        String
  fromAccountId String
  toAccountId   String
  fromAccount   Account  @relation("TransferFromAccount", fields: [fromAccountId, userId], references: [id, userId], onDelete: Restrict)
  toAccount     Account  @relation("TransferToAccount", fields: [toAccountId, userId], references: [id, userId], onDelete: Restrict)
  amount        Float
  date          DateTime
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, fromAccountId])
  @@index([userId, toAccountId])
}

model LoanPayment {
  id            String       @id @default(cuid())
  userId        String
  loanId        String
  loan          Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount        Float
  appliedAmount Float?
  date          DateTime
  description   String?
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, date])
  @@index([userId, loanId])
  @@index([loanId, date])
}
