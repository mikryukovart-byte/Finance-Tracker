generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkRecordType {
  NOTE
  DECISION
  RISK
  IDEA
  DAILY_REFLECTION
  WEEKLY_PLAN_DRAFT
  HYPOTHESIS_DRAFT
  ACTION_CANDIDATE
}

enum WorkRecordSource {
  TELEGRAM_TEXT
  TELEGRAM_VOICE
  WEB_MANUAL
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         String
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([id, userId])
  @@unique([userId, name, type])
  @@index([userId, type])
}

model Account {
  id                String        @id @default(cuid())
  userId            String
  name              String
  type              String        @default("DEBIT")
  balance           Float         @default(0)
  currency          String        @default("RUB")
  creditLimit       Float?
  currentDebt       Float         @default(0)
  availableCredit   Float         @default(0)
  minimalPayment    Float?
  paymentDate       DateTime?
  interestRate      Float?
  transactions      Transaction[]
  linkedLoans       Loan[]
  outgoingTransfers Transfer[]    @relation("TransferFromAccount")
  incomingTransfers Transfer[]    @relation("TransferToAccount")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([id, userId])
  @@unique([userId, name])
  @@index([userId, type])
  @@index([userId, currency])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String
  date        DateTime
  description String?
  categoryId  String?
  accountId   String?
  category    Category? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  account     Account? @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  loanPayments LoanPayment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, type, date])
  @@index([userId, accountId])
  @@index([userId, accountId, date])
  @@index([userId, categoryId, date])
  @@index([categoryId])
}

model Loan {
  id              String   @id @default(cuid())
  userId          String
  debtType        String   @default("BANK_LOAN")
  title           String
  lender          String?
  initialAmount   Float?
  remainingAmount Float
  monthlyPayment  Float?
  plannedPayment  Float?
  minimalPayment  Float?
  creditLimit     Float?
  interestRate    Float?
  gracePeriodDays Int?
  paymentDate     DateTime?
  accountId       String?
  account         Account? @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  priority        String   @default("MEDIUM")
  status          String   @default("ACTIVE")
  payments        LoanPayment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, debtType])
  @@index([userId, priority])
  @@index([userId, paymentDate])
  @@index([userId, accountId])
}

model Transfer {
  id            String   @id @default(cuid())
  userId        String
  fromAccountId String
  toAccountId   String
  fromAccount   Account  @relation("TransferFromAccount", fields: [fromAccountId, userId], references: [id, userId], onDelete: Restrict)
  toAccount     Account  @relation("TransferToAccount", fields: [toAccountId, userId], references: [id, userId], onDelete: Restrict)
  amount        Float
  date          DateTime
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, fromAccountId])
  @@index([userId, toAccountId])
}

model LoanPayment {
  id            String       @id @default(cuid())
  userId        String
  loanId        String
  loan          Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount        Float
  appliedAmount Float?
  date          DateTime
  description   String?
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, date])
  @@index([userId, loanId])
  @@index([loanId, date])
}

model AnnualGoalPlan {
  id         String          @id @default(cuid())
  userId     String
  year       Int
  pointA     Float           @default(0)
  pointAMode String          @default("AUTO")
  planStartDate DateTime     @default(now())
  c1Target   Float           @default(0)
  c2Target   Float           @default(0)
  c3Target   Float           @default(0)
  growthMode String          @default("LINEAR")
  rows       AnnualGoalRow[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([userId, year])
  @@index([userId, year])
}

model AnnualGoalRow {
  id            String         @id @default(cuid())
  planId        String
  plan          AnnualGoalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  rowKey        String
  month         Int?
  c1Value       Float          @default(0)
  c2Value       Float          @default(0)
  c3Value       Float          @default(0)
  kpiText       String?
  signatureText String?
  isClosed      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([planId, rowKey])
  @@index([planId, month])
}

model MonthlyTaktLevel {
  id          String   @id @default(cuid())
  userId      String
  year        Int
  level       Int
  description String
  amount      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year, level])
  @@index([userId, year])
}

model ThreeYearGoalScenario {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  speed     Float
  pointC    Float    @default(0)
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, speed])
  @@index([userId, year])
}

model CrisisSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  acuteReliefTarget    Float    @default(0)
  normalWorkTarget     Float    @default(0)
  requiredDailyExpense Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model WeeklyHypothesis {
  id             String   @id @default(cuid())
  userId         String
  weekStartDate  DateTime
  title          String
  actionPlan     String
  expectedResult String?
  actualResult   String?
  conclusion     String?
  status         String   @default("PLANNED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, weekStartDate])
  @@index([userId, status])
}

model DailyActionLog {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime
  weekStartDate DateTime
  type          String
  target        String?
  value         String?
  nextStep      String?
  note          String?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, weekStartDate])
  @@index([userId, type])
  @@index([userId, deletedAt])
  @@index([userId, date, deletedAt])
}

model TelegramPendingAction {
  id        String   @id @default(cuid())
  chatId    String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([chatId, expiresAt])
  @@index([expiresAt])
}

model WorkRecord {
  id               String           @id @default(cuid())
  userId           String
  title            String
  recordType       WorkRecordType
  summary          String
  insight          String?
  risk             String?
  nextStep         String?
  relatedWeekStart DateTime?        @db.Date
  source           WorkRecordSource
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([userId, recordType, createdAt])
  @@index([userId, recordType, deletedAt])
  @@index([userId, relatedWeekStart])
  @@index([userId, deletedAt])
}

model AdvisorReport {
  id              String   @id @default(cuid())
  userId          String
  periodStart     DateTime @db.Date
  periodEnd       DateTime @db.Date
  content         String
  model           String
  source          String   @default("ai")
  contextSnapshot Json?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, periodStart, periodEnd])
}

model TelegramPendingWorkRecord {
  id        String   @id @default(cuid())
  chatId    String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([chatId, expiresAt])
  @@index([expiresAt])
}
